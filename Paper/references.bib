@Article{Calvert1997,
  author  = {Calvert, Gemma A. and Bullmore, Edward T. and Brammer, Michael J. and Campbell, Ruth and Williams, Steve C. R. and McGuire, Philip K. and Woodruff, Peter W. R. and Iversen, Susan D. and David, Anthony S.},
