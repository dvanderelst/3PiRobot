"""
SCRIPT_VisualDataAcquisition.py

Runner for vision-guided sonar data acquisition (Protocol B).

Reads a saved plan from AcquisitionArenas/<layout>/plans/plan_*.json, drives
the robot through the tour using TrackerNav, and pings at each (position, yaw)
combination. Output session goes to AcquisitionSessions/<session>/.

The plan is a complete spec — positions are in NN-reordered tour order, yaws
are baked in at build time, no runtime sampling. The runner just executes.

Per-ping artifact (one DataWriter file per ping):
    sonar_package      full output of client.read_and_process
    executed_pose      tracker (x_mm, y_mm, yaw_deg) at ping time, or None
    planned_position   (x_mm, y_mm) from the plan
    planned_yaw        deg, from the plan
    position_index     0..n_positions-1
    yaw_index          0..n_yaws-1 within the position
    ping_index         0..n_pings_total-1, monotonic across the session
    nav_success        bool, from go_to_pose result
    nav_pos_err_mm     final position error (mm) from the rotate step
    nav_yaw_err_deg    final yaw error (deg)

Ground-truth profiles are NOT computed at acquisition time — they're
deterministic given `(executed_pose, arena_walls)`, and computing offline
keeps the session decoupled from any future change to profile geometry.
"""

import json
import shutil
import time
from pathlib import Path

# Override the default DataWriter root so sessions land under
# AcquisitionSessions/ instead of SonarSessions/. Must happen before
# DataWriter is constructed (it captures Settings.data_folder at __init__).
from Library import Settings as _settings
_settings.data_folder = "AcquisitionSessions"

from Library import Client
from Library import CodeLogger
from Library import DataStorage
from Library import LorexTracker
from Library import PauseControl
from Library import PushOver
from Library.AcquisitionPlanner import load_arena, load_plan
from Library.TrackerNav import TrackerNav


# ── Settings ──────────────────────────────────────────────────────────────────
ROBOT_NUMBER          = 1
ARENA_NAME            = "Acquisition02"
PLAN_PATH             = None    # None → most recent AcquisitionArenas/<ARENA_NAME>/plans/plan_*.json
SESSION_NAME          = "Acquisition02A"
DO_PLOT_PINGS         = True    # per-ping sonar plot (debug only — slow)
PUSHOVER_EVERY_N      = 100


def _resolve(path_str: str) -> Path:
    p = Path(path_str)
    if not p.is_absolute():
        p = Path(__file__).resolve().parent / p
    return p.resolve()


def _latest_plan(arena_name: str) -> Path:
    """Return the most recent plan_*.json under AcquisitionArenas/<arena_name>/plans/.

    Plan filenames carry an ISO timestamp (`plan_YYYY-MM-DDTHH-MM-SS.json`),
    which sorts chronologically by lexicographic order, so the last entry
    after sorted() is the newest.
    """
    plans_dir = _resolve(f"AcquisitionArenas/{arena_name}/plans")
    if not plans_dir.is_dir():
        raise SystemExit(f"No plans folder at {plans_dir}")
    plan_files = sorted(plans_dir.glob("plan_*.json"))
    if not plan_files:
        raise SystemExit(f"No plan_*.json files in {plans_dir}")
    return plan_files[-1]


def _quick_pose(tracker, robot_number):
    """Single tracker read; returns (x, y, yaw_deg) or None.

    Used immediately after `nav.go_to_pose` returns — at that point the
    settle-poll has just completed inside the controller, so a single
    tracker read is enough for the executed-pose log entry."""
    pos = tracker.get_position(robot_number)
    if pos is None or pos.get("x") is None:
        return None
    return float(pos["x"]), float(pos["y"]), float(pos["yaw_deg"])


def main():
    if PLAN_PATH is None:
        plan_path = _latest_plan(ARENA_NAME)
        print(f"PLAN_PATH=None → using latest: {plan_path.name}")
    else:
        plan_path = _resolve(PLAN_PATH)
        if not plan_path.is_file():
            raise SystemExit(f"Plan not found: {plan_path}")

    plan = load_plan(plan_path)
    arena = load_arena(plan.arena_dir)  # validates the arena referenced by the plan

    n_positions = len(plan.positions)
    n_pings_total = sum(len(y) for y in plan.yaws_at_position)
    print(f"Loaded plan: {plan.arena_name}")
    print(f"  positions: {n_positions}")
    print(f"  pings (planned): {n_pings_total}")
    print(f"  source: {plan_path.name}")

    control = PauseControl.PauseControl()
    client = Client.Client(robot_number=ROBOT_NUMBER)
    tracker = LorexTracker.LorexTracker()

    nav = TrackerNav(
        client, tracker, ROBOT_NUMBER,
        pos_tol_mm=40.0,
        yaw_tol_deg=4.0,
        align_yaw_thresh_deg=15.0,
        max_step_distance_m=0.20,
        max_iterations=30,
        verbose=True,
    )

    writer = DataStorage.DataWriter(SESSION_NAME, autoclear=True, verbose=False)
    writer.add_file(str(Path(__file__).resolve()))
    writer.add_file('Library/Settings.py')
    writer.add_file(str(plan_path))

    session_root = _resolve(_settings.data_folder) / SESSION_NAME
    CodeLogger.log_code(str(session_root), ['.', 'Library'], label=SESSION_NAME)

    # Copy the plan and its companion plots into the session root so the
    # session is self-contained — what was planned, what it looked like, and
    # the per-waypoint diagnostics, all alongside session_meta.json.
    copy_sources = [plan_path, plan_path.with_suffix(".png")]
    if plan_path.stem.startswith("plan_"):
        copy_sources.append(
            plan_path.parent / f"diagnostics_{plan_path.stem[len('plan_'):]}.png"
        )
    for src in copy_sources:
        if src.exists():
            shutil.copy2(src, session_root / src.name)

    session_meta = {
        "arena_name": plan.arena_name,
        "arena_dir": plan.arena_dir,
        "plan_file": plan_path.name,
        "plan_seed": plan.seed,
        "n_positions_planned": n_positions,
        "n_pings_planned": n_pings_total,
        "robot_number": ROBOT_NUMBER,
        "started_at": time.strftime("%Y-%m-%dT%H-%M-%S"),
    }
    meta_path = session_root / "session_meta.json"
    with open(meta_path, "w") as f:
        json.dump(session_meta, f, indent=2)

    # Warm-up pings (matches SCRIPT_DataAcquisition pattern — wakes the
    # acoustic chain and flushes any stale buffers).
    for _ in range(5):
        client.acquire('ping')
        time.sleep(0.5)

    start_xy = plan.positions[0]
    print(f"\nPlace the robot near (x={start_xy[0]:.0f}, y={start_xy[1]:.0f}) mm. "
          f"Press Enter to begin (Ctrl-C to abort).")
    input()

    PushOver.send(f"Acquisition started: {SESSION_NAME} ({n_pings_total} pings)")

    ping_idx = 0
    nav_failures = 0
    ping_failures = 0
    t_start = time.time()

    for pos_idx, (xy, yaws) in enumerate(zip(plan.positions, plan.yaws_at_position)):
        control.wait_if_paused()
        print(f"\n=== position {pos_idx + 1}/{n_positions}: "
              f"({xy[0]:.0f}, {xy[1]:.0f}) ===")

        res_drive = nav.go_to_pose(xy[0], xy[1])
        if not res_drive.success:
            print(f"  nav to position failed: {res_drive.reason}; "
                  f"skipping {len(yaws)} pings")
            nav_failures += 1
            ping_idx += len(yaws)
            continue

        for yaw_idx, yaw in enumerate(yaws):
            control.wait_if_paused()

            # Rotate to the planned yaw. The position phase inside go_to_pose
            # is essentially a no-op since we're already there from the outer
            # drive call (or the previous yaw); only the yaw alignment runs.
            res_yaw = nav.go_to_pose(xy[0], xy[1], yaw)
            if not res_yaw.success:
                print(f"  rotate failed: {res_yaw.reason}; pinging anyway")

            executed_pose = _quick_pose(tracker, ROBOT_NUMBER)

            sonar_package = client.read_and_process(do_ping=True, plot=DO_PLOT_PINGS)
            if sonar_package is None:
                print(f"  ping failed at pos {pos_idx}, yaw {yaw_idx}")
                ping_failures += 1
                ping_idx += 1
                continue

            writer.save_data(
                sonar_package=sonar_package,
                executed_pose=executed_pose,
                planned_position=list(xy),
                planned_yaw=float(yaw),
                position_index=pos_idx,
                yaw_index=yaw_idx,
                ping_index=ping_idx,
                nav_success=res_yaw.success,
                nav_pos_err_mm=float(res_yaw.final_pos_err_mm),
                nav_yaw_err_deg=float(res_yaw.final_yaw_err_deg),
            )
            ping_idx += 1

            d = sonar_package.get("corrected_distance")
            i = sonar_package.get("corrected_iid")
            d_str = f"{d:.2f} m" if isinstance(d, (int, float)) else "N/A"
            i_str = f"{i:+.2f} dB" if isinstance(i, (int, float)) else "N/A"
            print(f"  ping {ping_idx}/{n_pings_total}: yaw={yaw:+.1f}°, "
                  f"d={d_str}, iid={i_str}")

            if PUSHOVER_EVERY_N > 0 and ping_idx % PUSHOVER_EVERY_N == 0:
                PushOver.send(f"Acquisition: {ping_idx}/{n_pings_total} pings")

    elapsed = time.time() - t_start
    print(f"\n=== Done ===")
    print(f"Duration: {elapsed/60:.1f} min")
    print(f"Pings collected: {ping_idx}/{n_pings_total}")
    print(f"Nav failures: {nav_failures} positions skipped")
    print(f"Ping failures: {ping_failures}")

    summary = {
        **session_meta,
        "finished_at": time.strftime("%Y-%m-%dT%H-%M-%S"),
        "duration_s": elapsed,
        "pings_collected": ping_idx,
        "nav_failures": nav_failures,
        "ping_failures": ping_failures,
    }
    with open(meta_path, "w") as f:
        json.dump(summary, f, indent=2)

    PushOver.send(
        f"Acquisition complete: {SESSION_NAME} "
        f"({ping_idx} pings, {nav_failures} nav fails, {ping_failures} ping fails)"
    )


if __name__ == "__main__":
    main()
